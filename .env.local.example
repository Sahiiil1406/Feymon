# Convex deployment
CONVEX_DEPLOYMENT=dev:watchful-bat-395
VITE_CONVEX_URL=https://watchful-bat-395.convex.cloud
VITE_CONVEX_SITE_URL=https://watchful-bat-395.convex.site

# LLM provider for Feynman AI Loop (convex/ai.ts + src/lib/ai.ts)
# Options: "openai" | "gemini" | "mock" (mock needs no key, great for local dev)
LLM_PROVIDER=mock
# If using OpenAI:
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# If using Gemini:
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Convex env (set via `npx convex env set LLM_PROVIDER openai` etc)
# These are read server-side via process.env in convex/actions ("use node")
# Also declare in convex/convex.config.ts for typed env access.
